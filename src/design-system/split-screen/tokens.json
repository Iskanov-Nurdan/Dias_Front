{
  "$schema": "Dias Line — split-screen design tokens (primitive -> semantic -> component)",
  "meta": {
    "name": "dias-split-screen",
    "version": "1.0.0",
    "description": "Dark brand panel + light form panel. Reference: Dias Line logo (red / black / white). Accent: #e11d3f.",
    "grid": { "unit": 8, "unit-unit": "px" },
    "breakpoints": { "mobile": 375, "tablet": 768, "desktop": 1440 }
  },

  "primitive": {
    "color": {
      "red": {
        "50": "#fef2f3",
        "100": "#fde6e8",
        "200": "#fbd0d6",
        "300": "#f7abb6",
        "400": "#f17b8d",
        "500": "#e8425e",
        "600": "#e11d3f",
        "700": "#b91538",
        "800": "#931530",
        "900": "#7a162c",
        "950": "#43070f"
      },
      "neutral": {
        "0": "#ffffff",
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "300": "#d4d4d8",
        "400": "#a1a1aa",
        "500": "#71717a",
        "600": "#52525b",
        "700": "#3f3f46",
        "800": "#27272a",
        "900": "#18181b",
        "950": "#0e0e10",
        "1000": "#0a0a0b"
      },
      "success": { "500": "#16a34a", "100": "#dcfce7" },
      "warning": { "500": "#d97706", "100": "#fef3c7" },
      "danger":  { "500": "#dc2626", "100": "#fee2e2" },
      "info":    { "500": "#0284c7", "100": "#e0f2fe" }
    },
    "font": {
      "family-heading": "'Manrope', 'Inter', system-ui, sans-serif",
      "family-body": "'Inter', system-ui, sans-serif",
      "family-mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
      "weight-regular": 400,
      "weight-medium": 500,
      "weight-semibold": 600,
      "weight-bold": 700,
      "weight-extrabold": 800
    },
    "size": {
      "10": "0.625rem",
      "12": "0.75rem",
      "13": "0.8125rem",
      "14": "0.875rem",
      "16": "1rem",
      "18": "1.125rem",
      "20": "1.25rem",
      "24": "1.5rem",
      "28": "1.75rem",
      "32": "2rem",
      "40": "2.5rem",
      "48": "3rem",
      "56": "3.5rem",
      "64": "4rem"
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px",
      "40": "160px"
    },
    "radius": {
      "none": "0px",
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "xl": "20px",
      "2xl": "28px",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(10,10,11,0.06)",
      "md": "0 4px 12px rgba(10,10,11,0.10)",
      "lg": "0 12px 32px rgba(10,10,11,0.14)",
      "xl": "0 24px 64px rgba(10,10,11,0.20)",
      "accent": "0 8px 24px rgba(225,29,63,0.28)",
      "focus-ring": "0 0 0 4px rgba(225,29,63,0.28)"
    },
    "duration": {
      "instant": "80ms",
      "fast": "150ms",
      "base": "220ms",
      "slow": "360ms",
      "slower": "560ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },

  "semantic": {
    "color": {
      "bg-dark-panel": "{primitive.color.neutral.1000}",
      "bg-dark-panel-elevated": "{primitive.color.neutral.950}",
      "bg-light-panel": "{primitive.color.neutral.0}",
      "bg-light-panel-subtle": "{primitive.color.neutral.50}",
      "surface-dark": "{primitive.color.neutral.950}",
      "surface-dark-raised": "{primitive.color.neutral.900}",
      "surface-light": "{primitive.color.neutral.0}",
      "surface-light-raised": "{primitive.color.neutral.50}",

      "text-on-dark": "{primitive.color.neutral.0}",
      "text-on-dark-secondary": "{primitive.color.neutral.300}",
      "text-on-dark-muted": "{primitive.color.neutral.400}",
      "text-on-light": "{primitive.color.neutral.900}",
      "text-on-light-secondary": "{primitive.color.neutral.600}",
      "text-on-light-muted": "{primitive.color.neutral.500}",

      "border-on-dark": "rgba(255,255,255,0.12)",
      "border-on-dark-subtle": "rgba(255,255,255,0.06)",
      "border-on-light": "{primitive.color.neutral.200}",
      "border-on-light-subtle": "{primitive.color.neutral.100}",

      "accent": "{primitive.color.red.600}",
      "accent-hover": "{primitive.color.red.700}",
      "accent-active": "{primitive.color.red.800}",
      "accent-muted-on-light": "{primitive.color.red.100}",
      "accent-muted-on-dark": "rgba(225,29,63,0.18)",
      "accent-text-on-fill": "{primitive.color.neutral.0}",
      "accent-text-readable": "{primitive.color.red.700}",

      "success": "{primitive.color.success.500}",
      "warning": "{primitive.color.warning.500}",
      "danger": "{primitive.color.danger.500}",
      "info": "{primitive.color.info.500}",

      "focus-ring": "rgba(225,29,63,0.45)"
    },
    "font": {
      "heading": "{primitive.font.family-heading}",
      "body": "{primitive.font.family-body}"
    },
    "type-scale": {
      "h1": { "size": "3rem",   "mobile-size": "2rem",    "weight": "{primitive.font.weight-extrabold}", "line-height": 1.08, "letter-spacing": "-0.02em" },
      "h2": { "size": "2.25rem","mobile-size": "1.625rem","weight": "{primitive.font.weight-bold}",      "line-height": 1.14, "letter-spacing": "-0.01em" },
      "h3": { "size": "1.75rem","mobile-size": "1.375rem","weight": "{primitive.font.weight-bold}",      "line-height": 1.2,  "letter-spacing": "-0.01em" },
      "h4": { "size": "1.375rem","mobile-size": "1.1875rem","weight": "{primitive.font.weight-semibold}","line-height": 1.25, "letter-spacing": "0" },
      "h5": { "size": "1.125rem","mobile-size": "1.0625rem","weight": "{primitive.font.weight-semibold}","line-height": 1.3,  "letter-spacing": "0" },
      "h6": { "size": "1rem",   "mobile-size": "1rem",     "weight": "{primitive.font.weight-semibold}", "line-height": 1.35, "letter-spacing": "0" },
      "body-lg": { "size": "1.125rem", "weight": "{primitive.font.weight-regular}", "line-height": 1.6 },
      "body":    { "size": "1rem",     "weight": "{primitive.font.weight-regular}", "line-height": 1.6 },
      "body-sm": { "size": "0.875rem", "weight": "{primitive.font.weight-regular}", "line-height": 1.55 },
      "caption": { "size": "0.75rem",  "weight": "{primitive.font.weight-medium}",  "line-height": 1.4, "letter-spacing": "0.01em" },
      "label":   { "size": "0.8125rem","weight": "{primitive.font.weight-semibold}","line-height": 1.3, "letter-spacing": "0.01em" }
    }
  },

  "component": {
    "container": {
      "max-width-desktop": "1440px",
      "content-max-width": "1200px",
      "form-max-width": "440px",
      "padding-x-mobile": "{primitive.space.4}",
      "padding-x-tablet": "{primitive.space.8}",
      "padding-x-desktop": "{primitive.space.16}",
      "section-gap-mobile": "{primitive.space.16}",
      "section-gap-desktop": "{primitive.space.32}"
    },
    "split-screen": {
      "panel-dark-width": "50%",
      "panel-dark-width-tablet": "42%",
      "panel-light-width": "50%",
      "panel-light-width-tablet": "58%",
      "stack-breakpoint": "768px"
    },
    "header": {
      "height": "72px",
      "height-mobile": "56px",
      "bg": "{semantic.color.bg-dark-panel}",
      "border-bottom": "1px solid {semantic.color.border-on-dark-subtle}",
      "padding-x": "{primitive.space.8}"
    },
    "hero": {
      "padding-y-desktop": "{primitive.space.24}",
      "padding-y-mobile": "{primitive.space.12}",
      "title-max-width": "560px",
      "eyebrow-color": "{semantic.color.accent}",
      "eyebrow-size": "{semantic.type-scale.label.size}"
    },
    "footer": {
      "bg": "{semantic.color.bg-dark-panel}",
      "border-top": "1px solid {semantic.color.border-on-dark-subtle}",
      "padding-y": "{primitive.space.12}",
      "text-color": "{semantic.color.text-on-dark-muted}"
    },
    "button": {
      "height-sm": "32px",
      "height-md": "40px",
      "height-lg": "48px",
      "padding-x-sm": "{primitive.space.3}",
      "padding-x-md": "{primitive.space.5}",
      "padding-x-lg": "{primitive.space.6}",
      "radius": "{primitive.radius.md}",
      "font-size": "{semantic.type-scale.label.size}",
      "font-weight": "{primitive.font.weight-semibold}",
      "gap": "{primitive.space.2}",
      "transition": "background-color {primitive.duration.fast} {primitive.easing.standard}, border-color {primitive.duration.fast} {primitive.easing.standard}, transform {primitive.duration.instant} {primitive.easing.standard}, box-shadow {primitive.duration.fast} {primitive.easing.standard}",

      "primary-bg": "{semantic.color.accent}",
      "primary-bg-hover": "{semantic.color.accent-hover}",
      "primary-bg-active": "{semantic.color.accent-active}",
      "primary-text": "{semantic.color.accent-text-on-fill}",
      "primary-shadow-hover": "{primitive.shadow.accent}",

      "secondary-bg": "transparent",
      "secondary-border": "1px solid {semantic.color.border-on-light}",
      "secondary-border-hover": "1px solid {primitive.color.neutral.300}",
      "secondary-text": "{semantic.color.text-on-light}",
      "secondary-bg-hover": "{primitive.color.neutral.50}",

      "ghost-bg": "transparent",
      "ghost-bg-hover": "rgba(225,29,63,0.08)",
      "ghost-text": "{semantic.color.accent}",

      "disabled-bg": "{primitive.color.neutral.100}",
      "disabled-text": "{primitive.color.neutral.400}",
      "disabled-border": "{primitive.color.neutral.200}"
    },
    "input": {
      "height": "44px",
      "padding-x": "{primitive.space.4}",
      "radius": "{primitive.radius.md}",
      "bg": "{primitive.color.neutral.0}",
      "border": "1px solid {semantic.color.border-on-light}",
      "border-hover": "1px solid {primitive.color.neutral.300}",
      "border-focus": "1px solid {semantic.color.accent}",
      "ring-focus": "0 0 0 4px {semantic.color.accent-muted-on-light}",
      "border-error": "1px solid {primitive.color.danger.500}",
      "ring-error": "0 0 0 4px {primitive.color.danger.100}",
      "text": "{semantic.color.text-on-light}",
      "placeholder": "{semantic.color.text-on-light-muted}",
      "bg-disabled": "{primitive.color.neutral.50}",
      "text-disabled": "{primitive.color.neutral.400}",
      "font-size": "{semantic.type-scale.body.size}"
    },
    "select": {
      "extends": "input",
      "chevron-color": "{semantic.color.text-on-light-secondary}",
      "dropdown-bg": "{primitive.color.neutral.0}",
      "dropdown-shadow": "{primitive.shadow.lg}",
      "dropdown-radius": "{primitive.radius.lg}",
      "option-hover-bg": "{primitive.color.neutral.50}",
      "option-selected-bg": "{semantic.color.accent-muted-on-light}",
      "option-selected-text": "{semantic.color.accent-text-readable}"
    },
    "checkbox": {
      "size": "20px",
      "radius": "{primitive.radius.sm}",
      "border": "1.5px solid {primitive.color.neutral.300}",
      "bg": "{primitive.color.neutral.0}",
      "bg-checked": "{semantic.color.accent}",
      "border-checked": "{semantic.color.accent}",
      "check-mark": "{primitive.color.neutral.0}",
      "bg-disabled": "{primitive.color.neutral.100}",
      "border-disabled": "{primitive.color.neutral.200}"
    },
    "card": {
      "bg": "{primitive.color.neutral.0}",
      "border": "1px solid {semantic.color.border-on-light-subtle}",
      "radius": "{primitive.radius.xl}",
      "padding": "{primitive.space.6}",
      "shadow": "{primitive.shadow.md}",
      "shadow-hover": "{primitive.shadow.lg}",
      "transition": "transform {primitive.duration.base} {primitive.easing.decelerate}, box-shadow {primitive.duration.base} {primitive.easing.decelerate}"
    },
    "modal": {
      "overlay-bg": "rgba(10,10,11,0.6)",
      "bg": "{primitive.color.neutral.0}",
      "radius": "{primitive.radius.2xl}",
      "padding": "{primitive.space.8}",
      "shadow": "{primitive.shadow.xl}",
      "max-width": "480px",
      "transition-enter": "opacity {primitive.duration.base} {primitive.easing.decelerate}, transform {primitive.duration.base} {primitive.easing.spring}"
    },
    "nav": {
      "link-text": "{semantic.color.text-on-dark-secondary}",
      "link-text-hover": "{semantic.color.text-on-dark}",
      "link-text-active": "{semantic.color.accent}",
      "link-underline-active": "{semantic.color.accent}",
      "mobile-menu-bg": "{semantic.color.bg-dark-panel}"
    },
    "auth-hero": {
      "description": "Motorsport-premium full-bleed dark canvas variant, used by LoginPage — big telemetry-style typography over a diagonal racing-stripe accent, form as a floating glass card.",
      "display-size": "clamp(3.25rem, 8vw + 1rem, 8rem)",
      "display-size-mobile": "clamp(2.75rem, 16vw, 4rem)",
      "display-weight": "{primitive.font.weight-extrabold}",
      "display-line-height": 0.86,
      "display-letter-spacing": "-0.035em",
      "eyebrow-mono-size": "0.75rem",
      "eyebrow-tracking": "0.32em",
      "label-mono-size": "0.6875rem",
      "label-mono-tracking": "0.22em",
      "stripe-angle": "-6deg",
      "stripe-color": "{semantic.color.accent}",
      "stripe-width": "3px",
      "stripe-faint": "rgba(255,255,255,0.05)",
      "checker-cell": "9px",
      "checker-color": "rgba(255,255,255,0.08)",
      "watermark-color": "rgba(225,29,63,0.06)",
      "watermark-size": "clamp(14rem, 32vw, 26rem)",
      "watermark-size-mobile": "clamp(9rem, 60vw, 14rem)",
      "watermark-logo-opacity": 0.08,
      "glass-bg": "rgba(255,255,255,0.035)",
      "glass-bg-elevated": "rgba(255,255,255,0.05)",
      "glass-border": "rgba(255,255,255,0.1)",
      "glass-blur": "28px",
      "glass-radius": "{primitive.radius.2xl}",
      "glass-shadow": "0 32px 80px rgba(0,0,0,0.45)",
      "glass-accent-bar-height": "3px",
      "hairline-on-canvas": "rgba(255,255,255,0.09)"
    }
  }
}
